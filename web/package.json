{
  "name": "openbase-web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "OpenBase web client (React + TypeScript SPA, embedded into the Rust server binary).",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@glideapps/glide-data-grid": "6.0.3",
    "@tanstack/react-query": "^5.104.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lodash": "^4.18.1",
    "lucide-react": "^1.55.0",
    "marked": "18.1.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-responsive-carousel": "^3.2.23",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "overrides": {
    "@glideapps/glide-data-grid": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/marked": "4.3.2",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
