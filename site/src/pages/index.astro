---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import LIcon from "../components/LIcon.astro";
import markSvg from "../assets/brand/mark.svg?raw";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import path from "node:path";

const REPO = "https://github.com/lukewilson2002/openbase";

/**
 * A screenshot's URL with a hash of its bytes. Regenerated screenshots keep their file names and
 * /screenshots/* is cached for a day, so without this, visitors (and Cloudflare) would keep showing the
 * old app for up to a day after a redesign; a new hash is a new URL, so they fetch the new image.
 */
const shot = (file: string) => `/screenshots/${file}?v=${createHash("sha256").update(readFileSync(path.join(process.cwd(), "public/screenshots", file))).digest("hex").slice(0, 10)}`;
const TITLE = "OpenBase: a self-hosted Airtable alternative";
const DESCRIPTION =
  "Your own Airtable. One small server, no subscriptions. OpenBase is a free, open source, self-hosted Airtable alternative with grid, kanban, calendar and timeline views, automations, an Airtable-compatible API and a built-in MCP server for AI assistants.";

const features = [
  {
    icon: "layout-grid",
    title: "Seven views",
    text: "Grid, form, gallery, kanban, calendar, timeline with Gantt-style dependency arrows, and list. Nested filters, sorts, up to three grouping levels, row colours, summaries and CSV export.",
  },
  {
    icon: "sigma",
    title: "28 field types and real formulas",
    text: "Linked records paired both ways, lookups, rollups, attachments, currency, dates with time zones and more. Formulas use Airtable's syntax and its full function list.",
  },
  {
    icon: "zap",
    title: "Automations",
    text: "Start from a new record, a change, a form, a schedule or a webhook. Create or update records, send email, call an HTTP endpoint or notify people. Every run is logged and retried.",
  },
  {
    icon: "search",
    title: "Search everything",
    text: "Press Ctrl+K or ⌘K to find any workspace, base, table, view or record you can open, by name or by the text in its fields.",
  },
  {
    icon: "users",
    title: "Real-time collaboration",
    text: "Edits appear in other open tabs within moments. If two people change the same cell, the last write wins and the record history keeps both versions. Mentions and automation notices land in your Inbox.",
  },
  {
    icon: "user-plus",
    title: "Workspaces and members",
    text: "Invite people to a workspace with one of five roles, from owner to viewer, and let them open every base or only the ones you pick. The Members page shows who can open what.",
  },
  {
    icon: "share-2",
    title: "Share links and public forms",
    text: "Share a read-only view with an optional password, or publish a form that writes straight into a table. Comments, @mentions and per-record history are built in.",
  },
  {
    icon: "plug",
    title: "Airtable-compatible REST API",
    text: "A familiar API under /api/v1 with personal access tokens. Airtable clients and n8n, Make or Zapier HTTP steps work once you change the base URL.",
  },
  {
    icon: "bot",
    title: "Built-in MCP server",
    text: "Claude, ChatGPT and other AI assistants can connect by signing in, then build bases, edit records and set up automations for you, with the access you grant: read only, read and edit, or full control.",
  },
  {
    icon: "key-round",
    title: "Passkeys, 2FA and sessions",
    text: "Passkey sign-in, TOTP two-factor authentication, and sessions, API tokens and connected apps you can see and revoke.",
  },
  {
    icon: "database-backup",
    title: "Backups you can restore",
    text: "A daily automatic backup with retention, a backup and restore command, a snapshot before every schema upgrade, and one Trash page that keeps everything you delete for 30 days.",
  },
  {
    icon: "sparkles",
    title: "Easy to start",
    text: "A short intro on your first sign-in, a sidebar with your workspaces, bases, tables and views, and new bases that start by asking for their first table, or a spreadsheet to import.",
  },
];

// In pairs of equal height, since the grid shows two per row on wide screens.
const shots = [
  { key: "grid", title: "Grid with grouping and colours", alt: "OpenBase grid view of bakery orders in a card, grouped by status with coloured rows and a summary bar, with the tables and views in the sidebar", themed: true },
  { key: "kanban", title: "Kanban by status", alt: "OpenBase kanban view with order cards in New, Baking, Ready and Delivered stacks, each ending with Add and its count", themed: true },
  { key: "workspace", title: "Workspace home", alt: "OpenBase workspace page with a card for each base, its tables and the faces of people limited to it", themed: true },
  { key: "search", title: "Search everything", alt: "OpenBase search box open with results for “bake”: a workspace, a base, a view and records", themed: false },
  { key: "calendar", title: "Calendar by due date", alt: "OpenBase calendar view showing a month of orders on their due dates, with Month, Week and List switches", themed: false },
  { key: "timeline", title: "Timeline with dependencies", alt: "OpenBase timeline view of a production plan with swimlanes, a today line and dependency arrows", themed: false },
  { key: "gallery", title: "Gallery with photos", alt: "OpenBase gallery view of bakery products with photos, prices and allergens", themed: false },
  { key: "form-builder", title: "Form builder with live preview", alt: "OpenBase form builder with the form settings beside a live preview of a wholesale enquiry form", themed: false },
  { key: "members", title: "Members and their bases", alt: "OpenBase Members page: each person's bases and role in one row, and a pending invite", themed: false },
  { key: "trash", title: "One Trash for everything", alt: "OpenBase Trash page listing a deleted base, table, record, field and view, who deleted each and the days left to restore it", themed: false },
  { key: "automations", title: "Automations editor", alt: "OpenBase automation editor: a trigger, conditions and a list of actions", themed: false },
  { key: "assistants", title: "AI assistants page", alt: "OpenBase account page with the MCP address and steps to connect Claude, ChatGPT and other assistants", themed: true },
];
const PAGE_SHOTS = new Set(["workspace", "search", "members", "trash"]);
const dims = (key: string) => (key === "timeline" ? [2400, 1077] : PAGE_SHOTS.has(key) ? [2400, 1231] : [2400, 1477]);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "OpenBase",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Linux, macOS (self-hosted)",
  description: DESCRIPTION,
  url: "https://myopenbase.app/",
  license: "https://opensource.org/license/mit",
  codeRepository: REPO,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<StarlightPage
  frontmatter={{
    title: TITLE,
    description: DESCRIPTION,
    template: "splash",
    head: [{ tag: "title", content: TITLE }, { tag: "script", attrs: { type: "application/ld+json" }, content: JSON.stringify(jsonLd) }],
  }}
>
  <div class="ob-landing">
    <section class="hero" aria-labelledby="_top">
      <div class="hero-mark" set:html={markSvg} aria-hidden="true" />
      <h1 id="_top">OpenBase</h1>
      <p class="tagline">Your own Airtable. One small server, no subscriptions.</p>
      <p class="sub">
        A free, open source database with spreadsheet, kanban, calendar and form views. You run it on a server you control, and
        your data stays in one folder.
      </p>
      <div class="cta">
        <a class="btn primary" href="/docs/quickstart/">Get started</a>
        <a class="btn" href={REPO}>GitHub</a>
      </div>
      <p class="status">Version 0.1.0. Not yet used in production by anyone but its authors.</p>
      <figure class="hero-shot">
        <img class="only-light" src={shot("grid-light.webp")} width="2400" height="1477" alt="OpenBase grid view of bakery orders in a card, grouped by status with coloured rows and a summary bar, with the tables and views in the sidebar" fetchpriority="high" />
        <img class="only-dark" src={shot("grid-dark.webp")} width="2400" height="1477" alt="OpenBase grid view of bakery orders in a card, grouped by status with coloured rows and a summary bar, with the tables and views in the sidebar" loading="lazy" />
      </figure>
    </section>

    <section class="block" aria-labelledby="what">
      <h2 id="what">What it is</h2>
      <p class="lead">
        OpenBase is a self-hosted alternative to Airtable for individuals and very small businesses: tables, linked records,
        formulas, many kinds of views, automations, sharing and an API. The server is a single Rust program with the web app
        compiled in. The database, uploaded files and backups live in one directory, with no Postgres, no Redis and no Node at
        runtime.
      </p>
    </section>

    <section class="block" aria-labelledby="features">
      <h2 id="features">What you get</h2>
      <ul class="features">
        {
          features.map((f) => (
            <li>
              <span class="ficon">
                <LIcon name={f.icon} />
              </span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="screens">
      <h2 id="screens">See it</h2>
      <p class="lead">Real screenshots of OpenBase running a small demo bakery. The data is made up.</p>
      <div class="shots">
        {
          shots.map((s) => {
            const [w, h] = dims(s.key);
            return (
              <figure>
                {s.themed ? (
                  <>
                    <a class="only-light" href={shot(`${s.key}-light.webp`)}>
                      <img src={shot(`${s.key}-light.webp`)} width={w} height={h} alt={s.alt} loading="lazy" />
                    </a>
                    <a class="only-dark" href={shot(`${s.key}-dark.webp`)}>
                      <img src={shot(`${s.key}-dark.webp`)} width={w} height={h} alt={s.alt} loading="lazy" />
                    </a>
                  </>
                ) : (
                  <a href={shot(`${s.key}-light.webp`)}>
                    <img src={shot(`${s.key}-light.webp`)} width={w} height={h} alt={s.alt} loading="lazy" />
                  </a>
                )}
                <figcaption>{s.title}</figcaption>
              </figure>
            );
          })
        }
      </div>
    </section>

    <section class="block" aria-labelledby="server">
      <h2 id="server">Runs on a $5 server</h2>
      <p class="lead">
        OpenBase is built for a 1 vCPU, 1 GB VPS. These numbers are measured, but on a fast laptop (Apple M3 Max, 16 cores,
        64 GB), <strong>not on a $5 VPS</strong>, so treat times as best case.
      </p>
      <dl class="stats">
        <div>
          <dt>Memory, idle</dt>
          <dd>17.6 MB</dd>
          <dd class="note">release binary, right after start</dd>
        </div>
        <div>
          <dt>Memory, 50,000 records</dt>
          <dd>at most 104 MB</dd>
          <dd class="note">11 fields incl. a formula, over HTTP</dd>
        </div>
        <div>
          <dt>Page of 100 rows, cached</dt>
          <dd>1.4 ms</dd>
          <dd class="note">p95, 50,000 records</dd>
        </div>
        <div>
          <dt>Filter and two sorts, cold</dt>
          <dd>91-96 ms</dd>
          <dd class="note">18,006 matches of 50,000</dd>
        </div>
        <div>
          <dt>Binary</dt>
          <dd>26 MB</dd>
          <dd class="note">web app embedded</dd>
        </div>
        <div>
          <dt>Docker image</dt>
          <dd>41.5 MB</dd>
          <dd class="note">compressed, linux/arm64</dd>
        </div>
      </dl>
      <p class="fine">
        Not measured: a real 1 vCPU VPS, 100,000-record tables, 25 simultaneous users, upload-heavy workloads, or an amd64 build.
        The methods and every caveat are in the <a href={`${REPO}#resource-usage-and-scale`}>README</a>.
      </p>
    </section>

    <section class="block" aria-labelledby="free">
      <h2 id="free">No paywalls, no license keys</h2>
      <p class="lead">
        OpenBase is dual licensed under <a href={`${REPO}/blob/main/LICENSE-MIT`}>MIT</a> or <a href={`${REPO}/blob/main/LICENSE-APACHE`}>Apache-2.0</a>, at your option. There is no paid tier, no feature flags and
        nothing to activate. Every feature on this page is in the download.
      </p>
      <p class="lead">
        It is also deliberately small. There is no interface designer, no scripting extension, no SSO and no built-in AI: bring
        your own assistant through the MCP server or the API. The full list, with reasons, is in the <a href={`${REPO}#what-is-deliberately-not-included`}>README</a>.
      </p>
    </section>

    <section class="block" aria-labelledby="start">
      <h2 id="start">Start in a few commands</h2>
      <p class="lead">
        You need a server with Docker and a domain pointing at it. Caddy gets the HTTPS certificate for you. The first account you
        create becomes the administrator.
      </p>
      <pre class="snippet"><code>git clone https://github.com/lukewilson2002/openbase.git
cd openbase/deploy
cp .env.example .env        # set OPENBASE_DOMAIN=base.example.com
docker compose up -d</code></pre>
      <p class="fine">
        That pulls the official image, <code>ghcr.io/lukewilson2002/openbase</code>, for amd64 or arm64. To update later, run <code>docker compose pull &amp;&amp; docker compose up -d</code>. The <a href="/docs/quickstart/">quickstart</a> covers DNS, the first admin, backups and connecting an AI assistant.
      </p>
      <p class="cta">
        <a class="btn primary" href="/docs/quickstart/">Read the quickstart</a>
        <a class="btn" href="/docs/self-hosting/">Self-hosting guide</a>
      </p>
    </section>
  </div>
</StarlightPage>
