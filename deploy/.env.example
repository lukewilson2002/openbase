# Copy to deploy/.env and edit. Every OPENBASE_* option is documented in
# README.md ("Configuration").

# Public host name. DNS A/AAAA records must point at this server before the
# first start so Caddy can obtain a certificate.
OPENBASE_DOMAIN=base.example.com

# Which published image to run (ghcr.io/lukewilson2002/openbase:<this>). Nothing changes
# until you run `docker compose pull && docker compose up -d`.
#   latest   the newest stable release (default)
#   0.1      patch releases of 0.1 only. While OpenBase is 0.x, a new minor may break things.
#   1        the newest 1.x.y once 1.0 exists: updates without breaking changes
#   1.4.2    exactly this release; never changes. Pin this to roll back.
# Releases and what changed: https://github.com/lukewilson2002/openbase/releases
#OPENBASE_VERSION=latest

# Time zone for the daily backup hour (and log timestamps).
TZ=UTC

# Allow anyone to sign up (default: invite-only; the first account is admin).
OPENBASE_OPEN_SIGNUP=false

# Uploads, backups, retention.
OPENBASE_MAX_UPLOAD_MB=100
OPENBASE_BACKUP_HOUR=3
OPENBASE_BACKUP_KEEP=7
OPENBASE_TRASH_DAYS=30
OPENBASE_HISTORY_DAYS=365

# Outgoing email (invites, password resets, automations). Uncomment and fill
# in to enable; leave commented out to disable email (do not set them empty).
#OPENBASE_SMTP_HOST=smtp.example.com
#OPENBASE_SMTP_PORT=587
#OPENBASE_SMTP_USER=openbase@example.com
#OPENBASE_SMTP_PASSWORD=change-me
#OPENBASE_SMTP_SECURITY=starttls
#OPENBASE_SMTP_FROM=OpenBase <openbase@example.com>

# Logging: pretty or json; OPENBASE_LOG sets the filter (e.g. info, debug).
OPENBASE_LOG_FORMAT=pretty
OPENBASE_LOG=info

# Less common options (defaults shown; uncomment to change).
#OPENBASE_AUDIT_DAYS=365
#OPENBASE_EMAIL_PER_USER_HOUR=100
#OPENBASE_EMAIL_PER_HOUR=500
#OPENBASE_V1_RATE_PER_TOKEN=5
#OPENBASE_V1_RATE_PER_USER=50
#OPENBASE_MCP_RATE_PER_TOKEN=30
#OPENBASE_MCP_RATE_PER_USER=100
#OPENBASE_MCP_ALLOWED_ORIGINS=
# Let apps (Claude, ChatGPT, ...) register themselves for the OAuth sign-in of /mcp.
#OPENBASE_OAUTH_REGISTRATION=true
#OPENBASE_ALLOW_PRIVATE_WEBHOOKS=false
