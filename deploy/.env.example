# Copy to deploy/.env and edit. Every OPENGRID_* option is documented in
# README.md ("Configuration").

# Public host name. DNS A/AAAA records must point at this server before the
# first start so Caddy can obtain a certificate.
OPENGRID_DOMAIN=grid.example.com

# Time zone for the daily backup hour (and log timestamps).
TZ=UTC

# Allow anyone to sign up (default: invite-only; the first account is admin).
OPENGRID_OPEN_SIGNUP=false

# Uploads, backups, retention.
OPENGRID_MAX_UPLOAD_MB=100
OPENGRID_BACKUP_HOUR=3
OPENGRID_BACKUP_KEEP=7
OPENGRID_TRASH_DAYS=30
OPENGRID_HISTORY_DAYS=365

# Outgoing email (invites, password resets, automations). Uncomment and fill
# in to enable; leave commented out to disable email (do not set them empty).
#OPENGRID_SMTP_HOST=smtp.example.com
#OPENGRID_SMTP_PORT=587
#OPENGRID_SMTP_USER=opengrid@example.com
#OPENGRID_SMTP_PASSWORD=change-me
#OPENGRID_SMTP_SECURITY=starttls
#OPENGRID_SMTP_FROM=OpenGrid <opengrid@example.com>

# Logging: pretty or json; OPENGRID_LOG sets the filter (e.g. info, debug).
OPENGRID_LOG_FORMAT=pretty
OPENGRID_LOG=info
