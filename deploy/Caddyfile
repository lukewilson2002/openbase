# Caddy terminates TLS (certificates are obtained and renewed automatically)
# and forwards everything to OpenBase. OPENBASE_DOMAIN comes from deploy/.env.

{$OPENBASE_DOMAIN} {
	reverse_proxy openbase:8080 {
		# Stream Server-Sent Events (live updates) without buffering.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format console
	}
}
